    cats:['Travel','Portrait'], location:'Tokyo, Japan', price:200, rating:4.9, reviews:265,
    verified:true, response:'1 hour', delivery:'6 days', languages:'Japanese, English',
    bio:'Street and travel photography in Tokyo, Kyoto and Osaka. I know the quiet alleys that tourists never find and the best blue-hour rooftops.',
    cover:'https://picsum.photos/seed/lensly8/800/600' },

  { id:'c9', name:'Isabella Cruz', role:'Videographer', types:['videographer'],
    cats:['Music Video','Fashion'], location:'Mexico City, Mexico', price:210, rating:4.7, reviews:134,
    verified:false, response:'3 hours', delivery:'9 days', languages:'Spanish, English',
