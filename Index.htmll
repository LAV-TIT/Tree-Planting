/* ============================================================
   2. STATE + HELPERS
   ============================================================ */
const state = {
  q:'', loc:'', date:'',
  type:'all',
  cats:new Set(),
  maxPrice:600,
  minRating:0,
  sort:'recommended'
};

const $  = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const grad = i => GRADS[i % GRADS.length];
const initials = n => n.split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase();
const money = n => '$' + Math.round(n).toLocaleString('en-US');

let toastTimer;
function toast(msg){
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2600);
}

/* saved creators */
function getSaved(){ try { return JSON.parse(localStorage.getItem('lensly_saved')) || []; } catch(e){ return []; } }
function setSaved(a){ localStorage.setItem('lensly_saved', JSON.stringify(a)); }

/* bookings */
function getBookings(){ try { return JSON.parse(localStorage.getItem('lensly_bookings')) || []; } catch(e){ return []; } }
function setBookings(a){ localStorage.setItem('lensly_bookings', JSON.stringify(a)); }

/* ============================================================
   3. FILTER SIDEBAR BUILD
   ============================================================ */
function buildFilters(){
  const cats = [...new Set(CREATORS.flatMap(c => c.cats))].sort();
  $('#catFilters').innerHTML = cats.map(c => `
    <label class="check">
      <input type="checkbox" value="${c}">
      <span>${c}</span>
    </label>`).join('');

  $('#catFilters').addEventListener('change', e => {
    if(e.target.type !== 'checkbox') return;
    e.target.checked ? state.cats.add(e.target.value) : state.cats.delete(e.target.value);
    render();
  });

  $('#typeFilters').addEventListener('change', e => {
    state.type = e.target.value;
    render();
  });

  $('#priceRange').addEventListener('input', e => {
    state.maxPrice = +e.target.value;
    $('#priceLabel').textContent = '$' + e.target.value;
    render();
  });

  $('#ratingSelect').addEventListener('change', e => {
    state.minRating = parseFloat(e.target.value);
    render();
  });

  $('#sortSelect').addEventListener('change', e => {
    state.sort = e.target.value;
    render();
  });

  $('#clearBtn').addEventListener('click', () => {
    state.q = ''; state.loc = ''; state.date = '';
    state.type = 'all'; state.cats.clear();
    state.maxPrice = 600; state.minRating = 0; state.sort = 'recommended';

    $('#qInput').value = ''; $('#locInput').value = ''; $('#dateInput').value = '';
    $('#priceRange').value = 600; $('#priceLabel').textContent = '$600';
    $('#ratingSelect').value = '0'; $('#sortSelect').value = 'recommended';
    $$('#catFilters input').forEach(i => i.checked = false);
    $$('#typeFilters input')[0].checked = true;

    render();
    toast('Filters cleared');
  });
}

/* ============================================================
   4. FILTER + RENDER
   ============================================================ */
function filteredList(){
  const q = state.q.toLowerCase().trim();
  const loc = state.loc.toLowerCase().trim();

  let list = CREATORS.filter(c => {
    if(state.type !== 'all' && !c.types.includes(state.type)) return false;
    if(state.cats.size && !c.cats.some(x => state.cats.has(x))) return false;
    if(c.price > state.maxPrice) return false;
    if(c.rating < state.minRating) return false;

    if(q){
      const hay = (c.name + ' ' + c.role + ' ' + c.cats.join(' ') + ' ' + c.bio + ' ' + c.location).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    if(loc && !c.location.toLowerCase().includes(loc)) return false;
    return true;
  });

  switch(state.sort){
    case 'price-asc':  list.sort((a,b) => a.price - b.price); break;
    case 'price-desc': list.sort((a,b) => b.price - a.price); break;
    case 'rating':     list.sort((a,b) => b.rating - a.rating); break;
    default:           list.sort((a,b) => (b.verified - a.verified) || (b.rating - a.rating));
  }
  return list;
}

function cardHTML(c, i){
  const g = grad(i);
  const saved = getSaved().includes(c.id);
  return `
  <article class="card">
    <div class="card-cover" data-profile="${c.id}"
         style="background-image:url('${c.cover}'),${g}">
      ${c.verified ? '<span class="badge">✓ Verified</span>' : ''}
      <button class="heart ${saved ? 'on' : ''}" data-save="${c.id}"
              aria-label="Save creator">${saved ? '♥' : '♡'}</button>
    </div>
    <div class="card-body">
      <div class="card-head">
        <div class="avatar" style="background:${g}">${initials(c.name)}</div>
        <div class="who">
          <h3>${c.name}</h3>
          <p>${c.role} · ${c.location}</p>
        </div>
        <div class="score">★ ${c.rating.toFixed(1)}<span>(${c.reviews})</span></div>
      </div>
      <div class="tags">${c.cats.map(t => `<span class="tag">${t}</span>`).join('')}</div>
      <div class="card-foot">
        <div class="price"><strong>${money(c.price)}</strong> /hr</div>
        <div class="card-btns">
          <button class="btn ghost sm" data-profile="${c.id}">Profile</button>
          <button class="btn primary sm" data-book="${c.id}">Book</button>
        </div>
      </div>
    </div>
  </article>`;
}

function render(){
  const list = filteredList();
  const grid = $('#grid');

  $('#resultCount').textContent = list.length
    ? `${list.length} creator${list.length > 1 ? 's' : ''} available${state.loc ? ' in ' + state.loc : ''}`
    : 'No creators match your search';

  if(!list.length){
    grid.innerHTML = `
      <div class="empty">
        <h3>Nothing here yet</h3>
        <p>Try widening your price range or clearing a filter.</p>
      </div>`;
    return;
  }
  grid.innerHTML = list.map(cardHTML).join('');
}

/* ============================================================
   5. CARD INTERACTIONS
   ============================================================ */
$('#grid').addEventListener('click', e => {
  const saveBtn = e.target.closest('[data-save]');
  if(saveBtn){
    const id = saveBtn.dataset.save;
    let saved = getSaved();
    if(saved.includes(id)){
      saved = saved.filter(x => x !== id);
      saveBtn.classList.remove('on');
      saveBtn.textContent = '♡';
      toast('Removed from saved');
    } else {
      saved.push(id);
      saveBtn.classList.add('on');
      saveBtn.textContent = '♥';
      toast('Saved to your list ♥');
    }
    setSaved(saved);
    return;
  }

  const bookBtn = e.target.closest('[data-book]');
  if(bookBtn){ openBooking(bookBtn.dataset.book); return; }

  const profBtn = e.target.closest('[data-profile]');
  if(profBtn){ openProfile(profBtn.dataset.profile); return; }
});

/* ============================================================
   6. BOOKING MODAL
   ============================================================ */
let bookingCreator = null;

function openBooking(id){
  const c = CREATORS.find(x => x.id === id);
  if(!c) return;
  bookingCreator = c;

  const today = new Date().toISOString().split('T')[0];
  const preselect = state.date || today;
  const g = grad(CREATORS.indexOf(c));

  $('#bookingModal').innerHTML = `
    <div class="modal-head">
      <h3>Book a session</h3>
      <button class="x-btn" data-close>✕</button>
    </div>
    <div class="modal-body">
      <div class="summary">
        <div class="avatar" style="background:${g}">${initials(c.name)}</div>
        <div>
          <h4>${c.name}</h4>
          <p>${c.role} · ${c.location} · ${money(c.price)}/hr</p>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Date</label>
          <input type="date" id="bkDate" min="${today}" value="${preselect}">
        </div>
        <div class="form-group">
          <label>Start time</label>
          <input type="time" id="bkTime" value="10:00">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Duration</label>
          <select id="bkHours">
            ${[1,2,3,4,5,6,8].map(h => `<option value="${h}" ${h===2?'selected':''}>${h} hour${h>1?'s':''}</option>`).join('')}
          </select>
        </div>
        <div class="form-group">
          <label>Session type</label>
          <select id="bkType">
            ${c.cats.map(t => `<option>${t}</option>`).join('')}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>Notes for ${c.name.split(' ')[0]} (optional)</label>
        <textarea id="bkNotes" placeholder="Location ideas, mood, number of people, deliverables…"></textarea>
      </div>

      <div class="bill">
        <div class="bill-row"><span>Hourly rate</span><span>${money(c.price)}</span></div>
        <div class="bill-row"><span>Hours</span><span id="bkHoursLabel">2</span></div>
        <div class="bill-row"><span>Service fee (5%)</span><span id="bkFee">${money(c.price * 2 * 0.05)}</span></div>
        <div class="bill-row total"><span>Total</span><span id="bkTotal">${money(c.price * 2 * 1.05)}</span></div>
      </div>

      <button class="btn primary block" id="bkConfirm">Confirm booking</button>
    </div>`;

  $('#bookingOverlay').classList.add('open');

  const hoursEl = $('#bkHours');
  const updateBill = () => {
    const h = +hoursEl.value;
    const sub = c.price * h;
    const fee = sub * 0.05;
    $('#bkHoursLabel').textContent = h;
    $('#bkFee').textContent = money(fee);
    $('#bkTotal').textContent = money(sub + fee);
  };
  hoursEl.addEventListener('change', updateBill);
  updateBill();

  $('#bkConfirm').addEventListener('click', () => {
    const date = $('#bkDate').value;
    const time = $('#bkTime').value || '10:00';
    const hours = +hoursEl.value;
    const type = $('#bkType').value;

    if(!date){ toast('Please choose a date'); return; }

    const sub = c.price * hours;
    const total = Math.round(sub * 1.05);

    const bookings = getBookings();
    bookings.unshift({
      id: 'b' + Date.now(),
      creatorId: c.id,
      creatorName: c.name,
      role: c.role,
      location: c.location,
      date, time, hours, type,
      total,
      notes: $('#bkNotes').value.trim()
    });
    setBookings(bookings);

    $('#bookingOverlay').classList.remove('open');
    toast(`Booked! ${c.name.split(' ')[0]} will confirm shortly 🎉`);
  });
}

/* ============================================================
   7. PROFILE MODAL
   ============================================================ */
function openProfile(id){
  const c = CREATORS.find(x => x.id === id);
  if(!c) return;
  const idx = CREATORS.indexOf(c);
  const g = grad(idx);

  const shots = [1,2,3,4].map(n =>
    `<div style="background-image:url('https://picsum.photos/seed/${c.id}-p${n}/400/400'),${g}"></div>`
  ).join('');

  $('#profileModal').innerHTML = `
    <div style="position:relative">
      <div class="profile-cover" style="background-image:url('${c.cover}'),${g}"></div>
      <button class="x-btn" data-close
        style="position:absolute;top:16px;right:16px;background:rgba(255,255,255,.92)">✕</button>
    </div>

    <div class="profile-top">
      <div class="avatar" style="background:${g}">${initials(c.name)}</div>
      <div class="profile-meta">
        <h2>${c.name} ${c.verified ? '<span style="font-size:13px;color:#166534">✓</span>' : ''}</h2>
        <p>${c.role} · ${c.location}</p>
      </div>
      <div style="padding-bottom:8px;text-align:right">
        <div class="score" style="justify-content:flex-end">★ ${c.rating.toFixed(1)}<span>(${c.reviews} reviews)</span></div>
        <div style="font-size:14px;color:var(--muted);margin-top:4px"><strong style="font-size:18px;color:var(--text)">${money(c.price)}</strong> /hr</div>
      </div>
    </div>

    <div class="modal-body" style="padding-top:18px">
      <div class="tags" style="margin-bottom:18px">
        ${c.cats.map(t => `<span class="tag">${t}</span>`).join('')}
      </div>

      <p class="profile-bio">${c.bio}</p>

      <div class="profile-stats">
        <div class="stat"><strong>${c.response}</strong><span>Response time</span></div>
        <div class="stat"><strong>${c.delivery}</strong><span>Delivery</span></div>
        <div class="stat"><strong>${c.reviews}</strong><span>Sessions done</span></div>
      </div>

      <h4 style="font-size:14px;margin-bottom:4px">Languages</h4>
      <p style="font-size:13.5px;color:var(--muted);margin-bottom:20px">${c.languages}</p>

      <h4 style="font-size:14px;margin-bottom:10px">Portfolio</h4>
      <div class="portfolio">${shots}</div>

      <div style="display:flex;gap:10px;margin-top:22px">
        <button class="btn ghost" id="pfSave" style="flex:0 0 auto">${getSaved().includes(c.id) ? '♥ Saved' : '♡ Save'}</button>
        <button class="btn primary" id="pfBook" style="flex:1">Book ${c.name.split(' ')[0]} · ${money(c.price)}/hr</button>
      </div>
    </div>`;

  $('#profileOverlay').classList.add('open');

  $('#pfBook').addEventListener('click', () => {
    $('#profileOverlay').classList.remove('open');
    setTimeout(() => openBooking(c.id), 180);
  });

  $('#pfSave').addEventListener('click', () => {
    let saved = getSaved();
    if(saved.includes(c.id)){
      saved = saved.filter(x => x !== c.id);
      toast('Removed from saved');
    } else {
      saved.push(c.id);
      toast('Saved to your list ♥');
    }
    setSaved(saved);
    render();
    $('#pfSave').textContent = saved.includes(c.id) ? '♥ Saved' : '♡ Save';
  });
}

/* ============================================================
   8. MY BOOKINGS MODAL
   ============================================================ */
function openBookings(){
  const list = getBookings();
  $('#bookingsModal').innerHTML = `
    <div class="modal-head">
      <h3>My bookings</h3>
      <button class="x-btn" data-close>✕</button>
    </div>
    <div class="modal-body">
      ${list.length ? list.map(b => `
        <div class="booking-item">
          <div class="avatar" style="background:${grad(0)}">${initials(b.creatorName)}</div>
          <div>
            <h4>${b.creatorName}</h4>
            <p>${b.type} · ${b.date} at ${b.time} · ${b.hours}h</p>
          </div>
          <div class="amt">${money(b.total)}</div>
        </div>`).join('')
      : `<div class="empty" style="border:none;background:var(--soft)">
           <h3>No bookings yet</h3>
           <p>Find a creator and book your first session.</p>
         </div>`}
    </div>`;
  $('#bookingsOverlay').classList.add('open');
}

/* ============================================================
   9. GLOBAL EVENTS
   ============================================================ */
/* close buttons + backdrop clicks */
document.addEventListener('click', e => {
  if(e.target.closest('[data-close]')){
    e.target.closest('.overlay').classList.remove('open');
  }
});
$$('.overlay').forEach(ov => {
  ov.addEventListener('click', e => { if(e.target === ov) ov.classList.remove('open'); });
});
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') $$('.overlay.open').forEach(o => o.classList.remove('open'));
});

/* search form */
$('#searchForm').addEventListener('submit', e => {
  e.preventDefault();
  state.q = $('#qInput').value;
  state.loc = $('#locInput').value;
  state.date = $('#dateInput').value;
  render();
  document.getElementById('results').scrollIntoView({ behavior:'smooth', block:'start' });
});

/* quick chips */
$$('.chip').forEach(chip => {
  chip.addEventListener('click', () => {
    $('#qInput').value = chip.dataset.chip;
    state.q = chip.dataset.chip;
    render();
    document.getElementById('results').scrollIntoView({ behavior:'smooth' });
  });
});

/* header bookings link */
$('#navBookings').addEventListener('click', e => {
  e.preventDefault();
  openBookings();
});

/* ============================================================
   10. INIT
   ============================================================ */
$('#year').textContent = new Date().getFullYear();
buildFilters();
render();
</script>
</body>
</html>
